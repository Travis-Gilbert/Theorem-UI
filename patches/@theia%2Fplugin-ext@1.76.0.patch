+
+/**
+ * Ignores EPIPE on child process stdin under Bun.
+ *
+ * Extensions such as vscode.git spawn a process and immediately `stdin.end(input)` without an
+ * `error` listener. Node's `spawn` returns before the child runs, so the write lands in the pipe
+ * buffer even when the child never reads it. Bun's `spawn` returns later, often after a short-lived
+ * child has exited, so the write fails with EPIPE and, unhandled, crashes into the plugin host's
+ * uncaught exception handler. As execa does, EPIPE on stdin only means the child stopped reading;
+ * any other error still throws when nothing else handles it.
+ */
+import { ChildProcess } from 'child_process';
+import { Writable } from 'stream';
+
+const spawn = ChildProcess.prototype.spawn;
+ChildProcess.prototype.spawn = function (this: ChildProcess, ...args: Parameters<ChildProcess['spawn']>): void {
+    spawn.apply(this, args);
+    this.stdin?.on('error', function (this: Writable, error: NodeJS.ErrnoException): void {
+        if (error.code !== 'EPIPE' && this.listenerCount('error') === 1) {
+            throw error;
+        }
+    });
+};
