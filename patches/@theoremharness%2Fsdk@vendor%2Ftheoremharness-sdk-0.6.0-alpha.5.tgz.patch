new file mode 100644
index 0000000..ad9da8f
--- /dev/null
+++ b/dist/run-release.cjs
@@ -0,0 +1,33 @@
+// Keep in sync with packages/theorem-sdk/src/assistant-ui.ts.
+// A terminal event is committed before its thread link is cleared.
+module.exports = async function waitForRunRelease(client, threadId, runId, abortSignal) {
+  const deadline = new AbortController();
+  const expired = new Error("The completed Theorem run is still settling; reconnect to the thread before sending");
+  const timeout = setTimeout(() => deadline.abort(expired), 30000);
+  const signal = AbortSignal.any([abortSignal, deadline.signal]);
+  try {
+    while (true) {
+      signal.throwIfAborted();
+      const snapshot = await client.chat.threads.get(
+        { threadId }, { abortSignal: signal, maxRetries: 0 }
+      );
+      if (snapshot.thread.activeRunId !== runId && snapshot.liveRun?.runId !== runId)
+        return snapshot;
+      await new Promise((resolve) => {
+        const finish = () => {
+          clearTimeout(timer);
+          signal.removeEventListener("abort", finish);
+          resolve();
+        };
+        const timer = setTimeout(finish, 250);
+        signal.addEventListener("abort", finish, { once: true });
+        if (signal.aborted) finish();
+      });
+    }
+  } catch (error) {
+    if (deadline.signal.aborted && !abortSignal.aborted) throw expired;
+    throw error;
+  } finally {
+    clearTimeout(timeout);
+  }
+};
