diff --git a/node_modules/@theoremharness/sdk/dist/background-send-retry.cjs b/dist/background-send-retry.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..e598bb648c194d86cc79b6286a905e8a535e0286
--- /dev/null
+++ b/dist/background-send-retry.cjs
@@ -0,0 +1,62 @@
+const { dequal: equal } = require("dequal");
+
+// Only delivery lifecycle fields may differ. Titles, branch and all unknown
+// thread/snapshot scope metadata remain part of the exact comparison.
+function stableScope(snapshot) {
+  const { messages, liveRun, thread, ...scope } = snapshot;
+  const { revision, updatedAtMs, lastMessageAtMs, activeRunCursor, lastRun, ...identity } = thread;
+  return { ...scope, thread: identity };
+}
+
+function idle(snapshot) {
+  return !snapshot.liveRun && !snapshot.thread.activeRunId && !snapshot.thread.pendingTurn;
+}
+
+function completionChain(messages, parentId) {
+  return messages.every((message) => {
+    if (message.role !== "assistant" || message.parentMessageId !== parentId ||
+        typeof message.runId !== "string" || !message.runId) return false;
+    parentId = message.messageId;
+    return true;
+  });
+}
+
+function onlyCompletionAppend(before, after) {
+  const count = before.messages.length;
+  const parent = before.messages.at(-1);
+  return parent?.role === "assistant" && after.messages.length > count &&
+    equal(before.messages, after.messages.slice(0, count)) &&
+    completionChain(after.messages.slice(count), parent.messageId);
+}
+
+function safeBackgroundAdvance(before, after) {
+  return idle(before) && idle(after) && after.thread.revision > before.thread.revision &&
+    equal(stableScope(before), stableScope(after)) && onlyCompletionAppend(before, after);
+}
+
+// The SDK's native send is the only caller: this exact problem code denotes a
+// precommit revision refusal, unlike transport failures or a pending run start.
+function revisionRefused(error) {
+  return error?.statusCode === 409 && error?.body?.code === "chat_revision_conflict";
+}
+
+async function sendWithBackgroundRetry(client, request, snapshot, abortSignal) {
+  try {
+    return await client.chat.messages.send(request);
+  } catch (error) {
+    if (!revisionRefused(error)) throw error;
+    abortSignal.throwIfAborted();
+    const current = await client.chat.threads.get({ threadId: request.threadId }, { abortSignal });
+    abortSignal.throwIfAborted();
+    if (!safeBackgroundAdvance(snapshot, current)) throw error;
+    // expectedRevision participates in the durable idempotency hash. A refused
+    // attempt needs a new key; ambiguous sends still use normal saved replay.
+    return client.chat.messages.send({
+      ...request,
+      "If-Match": String(current.thread.revision),
+      "Idempotency-Key": crypto.randomUUID(),
+    });
+  }
+}
+
+module.exports = sendWithBackgroundRetry;
