    "@types/bun": "1.4.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test src",
    "export:ios": "expo export --platform ios --output-dir dist",
    "prebuild:ios": "expo prebuild --platform ios --no-install --clean",
    "doctor": "expo-doctor",
    "ghosttykit": "bash modules/theorem-session/scripts/fetch-ghosttykit.sh",
    "phonon": "bash modules/theo-speech/scripts/fetch-phonon.sh",
    "eas-build-pre-install": "bash modules/theorem-session/scripts/fetch-ghosttykit.sh && bash modules/theo-speech/scripts/fetch-phonon.sh"
  },
  "private": true
