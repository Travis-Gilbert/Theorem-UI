  "name": "theorem-ui",
  "private": true,
  "packageManager": "bun@1.4.3",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "e2e:stack": "node scripts/e2e/stack.mjs",
    "e2e:review": "node scripts/e2e/review.mjs",
    "e2e:models": "node scripts/e2e/models.mjs",
    "e2e:keys": "node scripts/e2e/keys.mjs",
    "e2e:notes": "node scripts/e2e/notes.mjs",
    "e2e:composer": "node scripts/e2e/composer.mjs",
    "e2e:sidebar": "node scripts/e2e/sidebar.mjs",
    "e2e:app-db": "node scripts/e2e/app-db.mjs",
    "e2e:app-ts": "node scripts/e2e/app-ts.mjs",
    "dev": "sh terminal/build.sh && bun --bun vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "sh scripts/build.sh",
    "build:cloudflare": "sh scripts/build-cloudflare.sh",
    "build:terminal": "sh terminal/build.sh",
    "start": "bun run .output/server/index.mjs",
    "deploy:cloudflare": "bun run build:cloudflare && wrangler deploy",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:composer": "bun test src/components/chat src/components/assistant-ui src/components/notes src/lib/theorem src/stories"
  },
