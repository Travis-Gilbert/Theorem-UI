{
  "private": true,
  "name": "theorem-ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.3"
  },
  "workspaces": [
    "applications/*",
    "theia-extensions/*"
  ],
  "scripts": {
    "postinstall": "theia-patch",
    "build": "bun run build:extensions && bun run build:browser",
    "build:extensions": "bun run --filter './theia-extensions/*' build",
    "build:browser": "bun run --cwd applications/browser build",
    "download:plugins": "theia download:plugins --rate-limit=15 --parallel=false",
    "start": "bun run --cwd applications/browser start"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0",
    "typescript": "~5.9.3"
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode-builtin-extensions": "https://github.com/eclipse-theia/vscode-builtin-extensions/releases/download/1.108.2/vscode-builtin-extensions-1.108.2.tar.gz"
  },
  "theiaPluginsExcludeIds": [
    "ms-vscode.js-debug-companion",
    "vscode.extension-editing",
    "vscode.microsoft-authentication"
  ],
  "patchedDependencies": {
    "drivelist@12.0.2": "patches/drivelist@12.0.2.patch",
    "@theia/core@1.76.0": "patches/@theia%2Fcore@1.76.0.patch",
    "node-pty@1.2.0-beta.12": "patches/node-pty@1.2.0-beta.12.patch",
    "@theia/plugin-ext@1.76.0": "patches/@theia%2Fplugin-ext@1.76.0.patch",
    "@theia/plugin-ext-vscode@1.76.0": "patches/@theia%2Fplugin-ext-vscode@1.76.0.patch",
    "@theia/terminal@1.76.0": "patches/@theia%2Fterminal@1.76.0.patch",
    "@theia/plugin-utils@1.76.0": "patches/@theia%2Fplugin-utils@1.76.0.patch"
  }
}
