+// Public License v. 2.0 are satisfied: GNU General Public License, version 2
+// with the GNU Classpath Exception which is available at
+// https://www.gnu.org/software/classpath/license.html.
+//
+// SPDX-License-Identifier: EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0
+// *****************************************************************************
+
+/* eslint-disable @typescript-eslint/no-explicit-any */
+
+/**
+ * Makes `Module._load` overrides work under Bun.
+ *
+ * The plugin host injects the `vscode` and `@theia/plugin` APIs, node-pty and the proxy-aware
+ * `http`/`https`/`tls` modules by replacing `Module._load`. Bun's `require` never calls
+ * `Module._load`, but it does call `Module._resolveFilename` for every request, built-ins included.
+ * This shim replays the installed `_load` chain from there: if an override answers the request, its
+ * value is placed in `require.cache` under a synthetic key and that key is returned as the resolved
+ * filename; otherwise resolution proceeds normally.
+ *
+ * Overrides must only call the previous `_load` to fall through (as all of Theia's do); during a
+ * replay that call resolves the request (throwing if it cannot be found) instead of loading it.
+ */
+const Module = require('module');
+
+interface Replay {
+    request: string;
+    parent: any;
+}
+
+const NOT_OVERRIDDEN = Symbol('not overridden');
+const nativeLoad: Function = Module._load;
+const nativeResolve: Function = Module._resolveFilename;
+const replays: Replay[] = [];
+
+function baseLoad(this: unknown, request: string, parent: any, isMain: boolean): unknown {
+    const replay = replays[replays.length - 1];
+    if (replay && replay.request === request && replay.parent === parent) {
+        nativeResolve.call(Module, request, parent, isMain);
+        return NOT_OVERRIDDEN;
+    }
+    return nativeLoad.apply(this, arguments);
+}
+
+let load: Function = baseLoad;
+Object.defineProperty(Module, '_load', {
+    configurable: true,
+    get: () => load,
+    set: (fn: Function) => { load = fn; }
+});
+
+Module._resolveFilename = function (this: unknown, request: string, parent: any, isMain: boolean): string {
+    if (load === baseLoad) {
+        return nativeResolve.apply(this, arguments);
+    }
+    replays.push({ request, parent });
+    let exports: unknown;
+    try {
+        exports = load.call(Module, request, parent, isMain);
+    } finally {
+        replays.pop();
+    }
+    if (exports === NOT_OVERRIDDEN) {
+        return nativeResolve.apply(this, arguments);
+    }
+    // One entry per requiring file and request, refreshed on every require like an uncached `_load`.
+    const key = `${parent?.filename ?? process.cwd()}.theia-module-override/${encodeURIComponent(request)}`;
+    let module = require.cache[key];
+    if (!module) {
+        module = new Module(key, parent);
+        module.filename = key;
+        module.loaded = true;
+        require.cache[key] = module;
+    }
+    module.exports = exports;
+    return key;
+};
