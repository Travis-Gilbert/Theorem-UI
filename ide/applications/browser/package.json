{
  "private": true,
  "name": "theorem-ui-browser-app",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "theia": {
    "target": "browser-only",
    "frontend": {
      "config": {
        "applicationName": "Theorem UI",
        "defaultTheme": {
          "light": "theorem-stone-light",
          "dark": "theorem-stone-dark"
        },
        "defaultIconTheme": "theia-file-icons",
        "preferences": {
          "files.enableTrash": false,
          "security.workspace.trust.enabled": false,
          "editor.fontFamily": "'Zed Mono', Lilex, Menlo, monospace",
          "editor.fontSize": 15,
          "editor.lineHeight": 1.618,
          "editor.fontLigatures": true,
          "editor.minimap.enabled": false,
          "editor.renderLineHighlight": "all",
          "terminal.integrated.fontFamily": "'Zed Mono', Lilex, Menlo, monospace",
          "terminal.integrated.fontSize": 15,
          "terminal.integrated.lineHeight": 1.618,
          "workbench.tree.indent": 20
        }
      }
    }
  },
  "dependencies": {
    "@theia/bulk-edit": "1.76.0",
    "@theia/callhierarchy": "1.76.0",
    "@theia/console": "1.76.0",
    "@theia/core": "1.76.0",
    "@theia/debug": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/editor-preview": "1.76.0",
    "@theia/file-search": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/getting-started": "1.76.0",
    "@theia/keymaps": "1.76.0",
    "@theia/markers": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/mini-browser": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/notebook": "1.76.0",
    "@theia/outline-view": "1.76.0",
    "@theia/output": "1.76.0",
    "@theia/plugin-ext": "1.76.0",
    "@theia/plugin-ext-vscode": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/process": "1.76.0",
    "@theia/scm": "1.76.0",
    "@theia/search-in-workspace": "1.76.0",
    "@theia/secondary-window": "1.76.0",
    "@theia/task": "1.76.0",
    "@theia/terminal": "1.76.0",
    "@theia/test": "1.76.0",
    "@theia/timeline": "1.76.0",
    "@theia/typehierarchy": "1.76.0",
    "@theia/userstorage": "1.76.0",
    "@theia/variable-resolver": "1.76.0",
    "@theia/vsx-registry": "1.76.0",
    "@theia/workspace": "1.76.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "theorem-ui-zed-look": "0.1.0",
    "theorem-ui-workspace": "0.1.0"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0"
  },
  "scripts": {
    "build": "theia build --app-target=browser-only --mode development",
    "build:prod": "theia build --app-target=browser-only",
    "start": "theia start"
  }
}
